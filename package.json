{
  "name": "dyslexiasteps-embed",
  "version": "0.1.1",
  "description": "Free reading games for any website: a <dyslexiasteps-game> web component and a React wrapper. Listen-and-find, build-the-word, choose-the-word and dictation in English, German, Spanish, French, Dutch and Brazilian Portuguese. No tracking in the frame.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "catalog.json",
    "src"
  ],
  "sideEffects": [
    "./src/index.js"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "homepage": "https://dyslexiasteps.com/embed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dyslexia-Steps/dyslexiasteps-embed.git"
  },
  "bugs": {
    "url": "https://github.com/Dyslexia-Steps/dyslexiasteps-embed/issues"
  },
  "keywords": [
    "reading",
    "phonics",
    "word-games",
    "education",
    "web-component",
    "embed",
    "iframe",
    "sight-words",
    "dyslexia",
    "teachers"
  ],
  "license": "MIT"
}
